{
  "name": "@partbuddy/desktop",
  "productName": "PartBuddy",
  "version": "0.1.0",
  "private": true,
  "description": "PartBuddy desktop app: Electron main process, preload bridge and renderer",
  "license": "GPL-3.0-or-later",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "lint": "eslint .",
    "typecheck": "tsc6 --noEmit -p tsconfig.node.json && tsc6 --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "dist:dir": "electron-vite build && electron-builder --win --dir --publish never"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.104",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@napi-rs/keyring": "2.1.2",
    "@partbuddy/design-tokens": "workspace:*",
    "@partbuddy/geometry": "workspace:*",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@shikijs/langs": "4.5.0",
    "@shikijs/themes": "4.5.0",
    "@tabler/icons-react": "3.50.0",
    "ai": "7.0.155",
    "electron-updater": "6.8.11",
    "fflate": "0.8.3",
    "i18next": "26.6.0",
    "i18next-icu": "2.6.1",
    "intl-messageformat": "12.1.4",
    "jose": "6.2.15",
    "ollama-ai-provider-v2": "4.1.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.10",
    "rehype-harden": "1.1.8",
    "shiki": "4.5.0",
    "streamdown": "2.7.1",
    "three": "0.187.0",
    "three-mesh-bvh": "0.9.17",
    "xstate": "5.33.3",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "tailwindcss": "4.3.3",
    "tailwindcss-react-aria-components": "2.2.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
