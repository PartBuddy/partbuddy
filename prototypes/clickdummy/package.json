{
  "name": "@partbuddy/clickdummy",
  "version": "0.1.0",
  "private": true,
  "description": "Clickable prototype of the PartBuddy main view with mock data",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc6 --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc6 --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "screens": "playwright test --project=screens"
  },
  "dependencies": {
    "@partbuddy/design-tokens": "workspace:*",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@tabler/icons-react": "3.50.0",
    "dockview-react": "8.7.1",
    "fflate": "0.8.3",
    "i18next": "26.5.11",
    "i18next-icu": "2.6.1",
    "intl-messageformat": "12.1.4",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-hotkeys-hook": "5.3.3",
    "react-i18next": "17.1.9",
    "three": "0.186.1",
    "three-mesh-bvh": "0.9.16",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "tailwindcss": "4.3.3",
    "tailwindcss-react-aria-components": "2.2.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
