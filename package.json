{
  "name": "partbuddy",
  "private": true,
  "description": "Desktop app for AI-assisted parametric design of FDM 3D-print parts",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@12.17.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "lint": "pnpm -r --no-sort --if-present run lint",
    "typecheck": "pnpm -r --no-sort --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "privacy:scan": "gitleaks git --no-banner --redact --config .gitleaks.toml .",
    "licenses:check": "node tools/licenses/check-licenses.mjs",
    "site:shots": "node tools/site-shots.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "lefthook": "2.2.2"
  }
}
