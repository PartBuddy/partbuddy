{
  "commands": [
    { "command": "parameters.add", "params": { "name": "base_length", "expression": "64 mm", "comment": "Base plate length [50..90]", "favorite": true } },
    { "command": "parameters.add", "params": { "name": "base_width", "expression": "32 mm", "comment": "Base plate width [26..48]", "favorite": true } },
    { "command": "parameters.add", "params": { "name": "base_thickness", "expression": "4 mm", "comment": "Base plate thickness [3..6]" } },
    { "command": "parameters.add", "params": { "name": "corner_radius", "expression": "4 mm", "comment": "Plate corner radius [2..6]" } },
    { "command": "parameters.add", "params": { "name": "edge_chamfer", "expression": "0.8 mm", "comment": "Top edge chamfer of the plate [0.4..1.2]" } },
    { "command": "parameters.add", "params": { "name": "clip_length", "expression": "20 mm", "comment": "Clip block length along X [16..30]" } },
    { "command": "parameters.add", "params": { "name": "clip_width", "expression": "20 mm", "comment": "Clip block width along the cable [12..30]" } },
    { "command": "parameters.add", "params": { "name": "clip_height", "expression": "16 mm", "comment": "Clip block height above the plate [14..24]" } },
    { "command": "parameters.add", "params": { "name": "cable_d_nominal", "expression": "12 mm", "comment": "Nominal cable diameter [6..16]", "favorite": true } },
    { "command": "parameters.add", "params": { "name": "channel_compensation", "expression": "0 mm", "comment": "Print compensation of the channel diameter; 0 until a calibration value exists (assumption)" } },
    { "command": "parameters.add", "params": { "name": "channel_axis_height", "expression": "8 mm", "comment": "Channel axis above the plate [6..12]" } },
    { "command": "parameters.add", "params": { "name": "slot_width", "expression": "9 mm", "comment": "Snap opening width, smaller than the cable [5..12]", "favorite": true } },
    { "command": "parameters.add", "params": { "name": "clip_fillet", "expression": "1.5 mm", "comment": "Rounding of the clip top edges [0.5..2]" } },
    { "command": "parameters.add", "params": { "name": "hole_spacing", "expression": "48 mm", "comment": "Distance between the mounting holes [36..70]" } },

    { "command": "solid.box", "params": { "length": "base_length", "width": "base_width", "height": "base_thickness", "center": [0, 0, "base_thickness/2"], "name": "BasePlate", "body_name": "CableClip" } },
    { "command": "solid.fillet", "params": { "edges": [[32, 16, 2], [-32, 16, 2], [32, -16, 2], [-32, -16, 2]], "radius": "corner_radius", "name": "PlateCorners" } },
    { "command": "solid.chamfer", "params": { "edges": [[0, 16, 4], [0, -16, 4], [32, 0, 4], [-32, 0, 4], [30.828, 14.828, 4], [-30.828, 14.828, 4], [30.828, -14.828, 4], [-30.828, -14.828, 4]], "distance": "edge_chamfer", "name": "PlateEdgeChamfer" } },
    { "command": "solid.box", "params": { "length": "clip_length", "width": "clip_width", "height": "clip_height", "center": [0, 0, "base_thickness + clip_height/2"], "operation": "join", "targets": ["CableClip"], "name": "ClipBlock" } },
    { "command": "solid.cylinder", "params": { "diameter": "cable_d_nominal + channel_compensation", "height": "clip_width + 2 mm", "base": [0, "-(clip_width/2 + 1 mm)", "base_thickness + channel_axis_height"], "axis": "Y", "operation": "cut", "targets": ["CableClip"], "name": "CableChannel" } },
    { "command": "solid.box", "params": { "length": "slot_width", "width": "clip_width + 2 mm", "height": "clip_height", "center": [0, 0, "base_thickness + channel_axis_height + clip_height/2"], "operation": "cut", "targets": ["CableClip"], "name": "SnapOpening" } },
    { "command": "solid.fillet", "params": { "edges": [[10, 0, 20], [-10, 0, 20], [4.5, 0, 20], [-4.5, 0, 20]], "radius": "clip_fillet", "name": "ClipTopRounds" } },
    { "command": "solid.hole", "params": { "position": ["hole_spacing/2", 0, "base_thickness"], "diameter": 3.4, "type": "countersink", "cs_diameter": 6.5, "cs_angle": 90, "name": "MountHoleRight" } },
    { "command": "solid.hole", "params": { "position": ["-hole_spacing/2", 0, "base_thickness"], "diameter": 3.4, "type": "countersink", "cs_diameter": 6.5, "cs_angle": 90, "name": "MountHoleLeft" } }
  ]
}
